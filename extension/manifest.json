{
  "manifest_version": 3,
  "name": "MECH TKMCE Focus Companion",
  "version": "1.0.0",
  "description": "Companion distraction-prevention extension for the MECH TKMCE Learning Operating System.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_title": "MECH TKMCE Focus",
    "default_popup": "intervention.html"
  }
}